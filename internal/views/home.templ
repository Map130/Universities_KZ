package views

templ Home() {
	@BaseLayout("Главная - Universities KZ") {
		<section class="hero" style="text-align: center; padding: 4rem 0;">
			<h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Поиск образовательных программ</h1>
			<p style="font-size: 1.25rem; color: #475569; margin-bottom: 2rem;">Найди свой идеальный университет и специальность в Казахстане</p>
			<div class="button-group">
				<a href="/universities" style="display: inline-block; background: var(--primary); color: white; padding: 0.75rem 1.5rem; border-radius: 6px; font-weight: 500;">Каталог вузов</a>
				<a href="/calculator" style="display: inline-block; background: white; color: var(--text-color); border: 1px solid #cbd5e1; padding: 0.75rem 1.5rem; border-radius: 6px; font-weight: 500;">Калькулятор ЕНТ</a>
			</div>
		</section>
	}
}
