package views

templ Home() {
	@BaseLayout("UniSearch — Найди свой университет в Казахстане") {
		<!-- Hero -->
		<section class="hero hero--photo">
			<h1 class="hero__title">
				Найди свой университет<br/>в Казахстане
			</h1>
			<p class="hero__desc">
				Ищи по названию вуза, специальности или городу
			</p>
			<div class="hero__search-wrap">
				<form class="hero-search" action="/universities" method="get">
					<input
						type="text"
						name="search"
						placeholder="КазНУ, Информатика, Алматы..."
						class="hero-search__input"
						autocomplete="off"
					/>
					<button type="submit" class="btn btn-primary">Найти</button>
				</form>
			</div>
			<div class="hero__tags">
				<a href="/universities?city=Алматы" class="tag-chip tag-chip--gray">Алматы</a>
				<a href="/universities?city=Астана" class="tag-chip tag-chip--gray">Астана</a>
				<a href="/universities?type=public" class="tag-chip tag-chip--gray">Государственные</a>
				<a href="/universities?type=private" class="tag-chip tag-chip--gray">Частные</a>
				<a href="/groups?search=IT" class="tag-chip tag-chip--purple">IT</a>
				<a href="/groups?search=Медицина" class="tag-chip tag-chip--purple">Медицина</a>
			</div>
		</section>

		<!-- Stats -->
		<div class="stats-strip">
			<div class="stats-strip__inner">
				<div class="stat-item">
					<div class="stat-item__value">150+</div>
					<div class="stat-item__label">университетов</div>
				</div>
				<div class="stat-item">
					<div class="stat-item__value">500+</div>
					<div class="stat-item__label">специальностей</div>
				</div>
				<div class="stat-item">
					<div class="stat-item__value">17</div>
					<div class="stat-item__label">городов</div>
				</div>
			</div>
		</div>

		<!-- Как это работает -->
		<div class="features">
			<div class="feature-card">
				<div class="feature-card__icon">🔍</div>
				<h3>Найди вуз</h3>
				<p>Ищи по названию, городу или типу — государственный или частный. Быстрые фильтры помогут сузить выбор.</p>
			</div>
			<div class="feature-card">
				<div class="feature-card__icon">📋</div>
				<h3>Сравни специальности</h3>
				<p>Смотри образовательные программы каждого вуза с минимальным баллом, количеством грантов и стоимостью.</p>
			</div>
			<div class="feature-card">
				<div class="feature-card__icon">🎓</div>
				<h3>Узнай шансы на грант</h3>
				<p>Введи баллы ЕНТ и профильные предметы — покажем список вузов и специальностей, куда ты проходишь на грант.</p>
			</div>
		</div>
	}
}
