package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ UniversityDetail(detail models.UniversityDetail) {
	@BaseLayout(fmt.Sprintf("%s - Universities KZ", detail.University.Name.RU)) {
		<div style="max-width: 1000px; margin: 0 auto; padding: 2rem 0;">
			<div class="card" style="margin-bottom: 2rem; padding: 2rem;">
				<div style="display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap;">
					if detail.University.LogoURL != nil {
						<div style="flex-shrink: 0; width: 120px; height: 120px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; background: white; padding: 0.5rem;">
							<img src={ *detail.University.LogoURL } alt="Логотип" style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
						</div>
					} else {
						<div style="flex-shrink: 0; width: 120px; height: 120px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; background: #f8fafc; color: #94a3b8;">
							<span>Нет логотипа</span>
						</div>
					}
					
					<div style="flex-grow: 1;">
						<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
							<h1 style="font-size: 2rem; margin: 0;">{ detail.University.Name.RU }</h1>
							if detail.University.Abbr != "" {
								<span style="background: #eff6ff; color: #3b82f6; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: 600;">{ detail.University.Abbr }</span>
							}
						</div>
						
						<div style="color: #64748b; margin-bottom: 1.5rem; display: flex; gap: 1.5rem; font-size: 1rem;">
							<span>📍 { detail.University.City }</span>
							<span>🏢 { string(detail.University.Type) }</span>
							if detail.University.Website != nil {
								<a href={ templ.SafeURL(*detail.University.Website) } target="_blank" style="color: #3b82f6; text-decoration: underline;">🌐 Официальный сайт</a>
							}
						</div>
						
						if detail.University.Description != nil {
							<div style="color: #475569; line-height: 1.6;">
								{ *detail.University.Description }
							</div>
						}
					</div>
				</div>
			</div>
			
			<h2 style="font-size: 1.5rem; margin-bottom: 1.5rem;">Образовательные программы (Специальности)</h2>
			
			if len(detail.Offers) == 0 {
				<div style="text-align: center; padding: 2rem; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; color: #64748b;">
					Нет данных о специальностях для данного вуза.
				</div>
			} else {
				<div class="card-grid">
					for _, offer := range detail.Offers {
						<div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
							<div style="margin-bottom: 1rem;">
								<div style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">Код: { offer.Out.Code }</div>
								<h3 style="font-size: 1.125rem; font-weight: 600; line-height: 1.4; margin: 0;">{ offer.Out.Name.RU }</h3>
							</div>
							
							<div style="border-top: 1px solid #e2e8f0; padding-top: 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.875rem;">
								<div>
									<div style="color: #64748b; margin-bottom: 0.25rem;">Мин. балл ЕНТ</div>
									<div style="font-weight: 600; color: #0f172a;">{ fmt.Sprintf("%d", offer.MinScore) }</div>
								</div>
								<div>
									<div style="color: #64748b; margin-bottom: 0.25rem;">Проходной (гранты)</div>
									<div style="font-weight: 600; color: #166534;">{ fmt.Sprintf("%d", offer.LastYearThreshold) }</div>
								</div>
								<div>
									<div style="color: #64748b; margin-bottom: 0.25rem;">Кол-во грантов</div>
									<div style="font-weight: 600; color: #0f172a;">{ fmt.Sprintf("%d", offer.GrantCount) }</div>
								</div>
								<div>
									<div style="color: #64748b; margin-bottom: 0.25rem;">Стоимость (₸/год)</div>
									<div style="font-weight: 600; color: #0f172a;">
										if offer.TuitionFee > 0 {
											{ fmt.Sprintf("%d", offer.TuitionFee) }
										} else {
											Неизвестно
										}
									</div>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}