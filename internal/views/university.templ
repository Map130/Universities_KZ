package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ UniversityDetail(detail models.UniversityDetail) {
	@BaseLayout(fmt.Sprintf("%s — UniSearch", detail.University.Name.RU)) {
		<div class="container">
			<div style="margin-bottom: 1.25rem;">
				<a href="/universities" class="btn btn-ghost btn-sm">← Все вузы</a>
			</div>

			<div class="uni-header">
				<div class="uni-header__logo">
					if detail.University.LogoURL != nil {
						<img src={ *detail.University.LogoURL } alt="Логотип"/>
					} else if detail.University.Abbr != "" {
						{ string([]rune(detail.University.Abbr)[:1]) }
					} else {
						U
					}
				</div>
				<div class="uni-header__info">
					<div class="uni-header__name">
						{ detail.University.Name.RU }
						if detail.University.Abbr != "" {
							<span class="badge badge-primary">{ detail.University.Abbr }</span>
						}
					</div>
					<div class="uni-header__meta">
						<span class="uni-header__meta-item">📍 { detail.University.City }</span>
						if detail.University.Type == "public" {
							<span class="uni-header__meta-item"><span class="badge badge-public">Государственный</span></span>
						} else {
							<span class="uni-header__meta-item"><span class="badge badge-private">Частный</span></span>
						}
						if detail.University.Website != nil {
							<a href={ templ.SafeURL(*detail.University.Website) } target="_blank" class="uni-header__meta-item" style="color: var(--color-primary);">
								🌐 Официальный сайт
							</a>
						}
					</div>
					if detail.University.Description != nil {
						<p class="uni-header__desc">{ *detail.University.Description }</p>
					}
				</div>
			</div>

			<div class="page-header">
				<h2>Проходные баллы на грант (ГОП)</h2>
				<p>{ fmt.Sprintf("%d", len(detail.EntRequirements)) } групп образовательных программ</p>
			</div>

			if len(detail.EntRequirements) == 0 {
				<div class="empty-state">
					<div class="empty-state__icon">📋</div>
					<h3>Нет данных о проходных баллах</h3>
				</div>
			} else {
				<div class="card-grid">
					for _, req := range detail.EntRequirements {
						<div class="offer-card">
							<div class="offer-card__code">ГОП { req.Out.Code }</div>
							<div class="offer-card__name">{ req.Out.Name.RU }</div>
							<div class="offer-stats">
								<div class="offer-stat">
									<div class="offer-stat__label">Мин. балл ЕНТ</div>
									<div class="offer-stat__value">{ fmt.Sprintf("%d", req.MinScore) }</div>
								</div>
								<div class="offer-stat">
									<div class="offer-stat__label">Порог гранта (прошлый год)</div>
									<div class="offer-stat__value offer-stat__value--success">{ fmt.Sprintf("%d", req.LastYearThreshold) }</div>
								</div>
							</div>
						</div>
					}
				</div>
			}

			<div class="page-header" style="margin-top: 3rem;">
				<h2>Образовательные программы (ОП)</h2>
				<p>{ fmt.Sprintf("%d", len(detail.Offers)) } специальностей</p>
			</div>

			if len(detail.Offers) == 0 {
				<div class="empty-state">
					<div class="empty-state__icon">📘</div>
					<h3>Нет данных о специальностях</h3>
				</div>
			} else {
				<div class="card-grid">
					for _, offer := range detail.Offers {
						<div class="offer-card" style="padding: 1rem;">
							<div class="offer-card__code">{ offer.Out.Code }</div>
							<div class="offer-card__name">{ offer.Out.Name.RU }</div>
						</div>
					}
				</div>
			}
		</div>
	}
}
