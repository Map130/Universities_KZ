package views

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/main.css"/>
			<script src="/static/js/htmx.min.js" defer></script>
		</head>
		<body hx-indicator="#global-indicator">
			@Navbar()
			<div id="global-indicator" class="htmx-indicator"></div>
			<main>
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

templ Navbar() {
	<header class="navbar">
		<a href="/" class="navbar__logo">UniSearch</a>
		<nav class="navbar__nav">
			<a href="/universities">Вузы</a>
			<a href="/groups">Образовательные программы</a>
			<a href="/calculator" class="navbar__cta">Узнать шансы на грант</a>
		</nav>
	</header>
}

templ Footer() {
	<footer class="footer">
		<p>&copy; 2026 UniSearch &mdash; Справочник абитуриента Казахстана</p>
	</footer>
}
