package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ Universities(unis []models.University) {
	@BaseLayout("Вузы — UniSearch") {
		<div class="container">
			<div class="page-header">
				<h1>Университеты Казахстана</h1>
				<p>Государственные и частные вузы — фильтруй по городу, типу или названию</p>
			</div>

			<div class="filter-bar">
				<form
					hx-get="/universities"
					hx-target="#university-list"
					hx-push-url="true"
					hx-trigger="input changed delay:500ms, search, change"
					hx-indicator="#uni-loading"
					class="filter-grid"
				>
					<div class="form-group">
						<label for="search" class="form-label">Название или аббревиатура</label>
						<input type="text" id="search" name="search" placeholder="КазНУ, МУИТ..." class="input"/>
					</div>
					<div class="form-group">
						<label for="city" class="form-label">Город</label>
						<input type="text" id="city" name="city" placeholder="Алматы, Астана..." class="input"/>
					</div>
					<div class="form-group">
						<label for="type" class="form-label">Тип</label>
						<select id="type" name="type" class="select">
							<option value="">Все типы</option>
							<option value="public">Государственный</option>
							<option value="private">Частный</option>
						</select>
					</div>
				</form>
			</div>

			<div id="uni-loading" class="htmx-indicator loading-text">
				Загружаем вузы...
			</div>

			<div id="university-list">
				@UniversityList(unis)
			</div>
		</div>
	}
}

templ UniversityList(unis []models.University) {
	<div class="results-count">
		Найдено: <strong>{ fmt.Sprintf("%d", len(unis)) }</strong>
	</div>

	if len(unis) == 0 {
		<div class="empty-state">
			<div class="empty-state__icon">🔍</div>
			<h3>Ничего не найдено</h3>
			<p>Попробуй изменить параметры поиска или фильтры</p>
		</div>
	} else {
		<div class="card-grid">
			for _, uni := range unis {
				<div class="uni-card">
					<div class="uni-card__top">
						<div class="uni-card__logo">
							if uni.LogoURL != nil {
								<img src={ *uni.LogoURL } alt={ uni.Abbr }/>
							} else if uni.Abbr != "" {
								<span class="uni-card__logo-placeholder">{ string([]rune(uni.Abbr)[:1]) }</span>
							} else {
								<span class="uni-card__logo-placeholder">U</span>
							}
						</div>
						<div class="uni-card__badges">
							if uni.Type == "public" {
								<span class="badge badge-public">Государственный</span>
							} else {
								<span class="badge badge-private">Частный</span>
							}
						</div>
					</div>

					<div class="uni-card__name">
						if uni.ID != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/universities/%v", uni.ID.ID)) } style="color: inherit;">{ uni.Name.RU }</a>
						} else {
							{ uni.Name.RU }
						}
					</div>

					<div class="uni-card__meta">
						<span>📍 { uni.City }</span>
						if uni.Abbr != "" {
							<span class="badge badge-primary">{ uni.Abbr }</span>
						}
					</div>

					<div class="uni-card__bottom">
						if uni.ID != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/universities/%v", uni.ID.ID)) } class="btn btn-secondary btn-sm btn-full">
								Подробнее →
							</a>
						}
					</div>
				</div>
			}
		</div>
	}
}
