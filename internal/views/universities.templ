package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ Universities(unis []models.University) {
	@BaseLayout("Каталог вузов - Universities KZ") {
		<div style="margin-bottom: 2rem;">
			<h1 style="font-size: 2rem;">Каталог университетов</h1>
			<p style="color: #64748b;">Найдено вузов: { fmt.Sprintf("%d", len(unis)) }</p>
		</div>

		<div class="card-grid">
			for _, uni := range unis {
				<div class="card">
					<h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
						if uni.ID != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/universities/%v", uni.ID.ID)) }>{ uni.Name.RU }</a>
						} else {
							{ uni.Name.RU }
						}
					</h2>
					<div style="color: #64748b; font-size: 0.875rem; margin-bottom: 1rem;">
						<span>📍 { uni.City }</span> • <span>🏢 { string(uni.Type) }</span>
					</div>
					if uni.Abbr != "" {
						<span style="display: inline-block; background: #eff6ff; color: #3b82f6; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">{ uni.Abbr }</span>
					}
				</div>
			}
		</div>
	}
}
