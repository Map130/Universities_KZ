package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ Universities(unis []models.University) {
	@BaseLayout("Каталог вузов - Universities KZ") {
		<div style="margin-bottom: 2rem;">
			<h1 style="font-size: 2rem; margin-bottom: 1.5rem;">Каталог университетов</h1>
			
			<div class="card" style="padding: 1.5rem; margin-bottom: 2rem; background: #f8fafc;">
				<form hx-get="/universities" hx-target="#university-list" hx-push-url="true" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end;">
					<div>
						<label for="search" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem;">Поиск по названию</label>
						<input type="text" id="search" name="search" placeholder="Напр: МУИТ" hx-trigger="keyup delay:300ms, search" style="width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 6px;"/>
					</div>
					<div>
						<label for="city" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem;">Город</label>
						<input type="text" id="city" name="city" placeholder="Напр: Алматы" hx-trigger="keyup delay:300ms, change" style="width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 6px;"/>
					</div>
					<div>
						<label for="type" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem;">Тип вуза</label>
						<select id="type" name="type" hx-trigger="change" style="width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 6px; background: white;">
							<option value="">Все типы</option>
							<option value="public">Государственный</option>
							<option value="private">Частный</option>
						</select>
					</div>
				</form>
			</div>
		</div>

		<div id="university-list">
			@UniversityList(unis)
		</div>
	}
}

templ UniversityList(unis []models.University) {
	<div style="margin-bottom: 1rem; color: #64748b; font-size: 0.875rem;">
		Найдено вузов: { fmt.Sprintf("%d", len(unis)) }
	</div>
	
	if len(unis) == 0 {
		<div style="text-align: center; padding: 3rem; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; color: #64748b;">
			По вашему запросу ничего не найдено.
		</div>
	} else {
		<div class="card-grid">
			for _, uni := range unis {
				<div class="card">
					<h2 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
						if uni.ID != nil {
							<a href={ templ.SafeURL(fmt.Sprintf("/universities/%v", uni.ID.ID)) }>{ uni.Name.RU }</a>
						} else {
							{ uni.Name.RU }
						}
					</h2>
					<div style="color: #64748b; font-size: 0.875rem; margin-bottom: 1rem;">
						<span>📍 { uni.City }</span> • <span>🏢 { string(uni.Type) }</span>
					</div>
					if uni.Abbr != "" {
						<span style="display: inline-block; background: #eff6ff; color: #3b82f6; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">{ uni.Abbr }</span>
					}
				</div>
			}
		</div>
	}
}
