package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ CalculatorPage(subjects []models.Subject) {
	@BaseLayout("Узнать шансы на грант — UniSearch") {
		<div class="container--narrow">
			<div class="page-header" style="text-align: center; padding-top: 1rem;">
				<h1>Узнать шансы на грант</h1>
				<p>Введи балл ЕНТ и профильные предметы — найдём подходящие вузы и специальности</p>
			</div>

			<div class="calc-card">
				<form
					hx-get="/calculator/results"
					hx-target="#calculator-results"
					hx-trigger="submit, change delay:600ms"
					hx-indicator="#calc-indicator"
				>
					<div class="calc-score-section" style="margin-bottom: 2rem;">
						<div class="calc-score-label">Твой балл ЕНТ</div>
						<div class="score-input-wrapper">
							<input
								type="number"
								id="score"
								name="score"
								min="0"
								max="140"
								required
								placeholder="—"
								class="score-input"
							/>
							<span class="score-max">из 140</span>
						</div>
					</div>

					<div class="calc-grid">
						<div class="form-group">
							<label for="subject1" class="form-label">Первый профильный предмет</label>
							<select id="subject1" name="subject1" required class="select">
								<option value="" disabled selected>Выберите предмет</option>
								for _, s := range subjects {
									<option value={ s.Code }>{ s.Name.RU }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="subject2" class="form-label">Второй профильный предмет</label>
							<select id="subject2" name="subject2" required class="select">
								<option value="" disabled selected>Выберите предмет</option>
								for _, s := range subjects {
									<option value={ s.Code }>{ s.Name.RU }</option>
								}
							</select>
						</div>
						<div class="form-group" style="grid-column: 1 / -1;">
							<label for="city" class="form-label">Город (необязательно)</label>
							<input
								type="text"
								id="city"
								name="city"
								placeholder="Например: Алматы, Астана..."
								class="input"
							/>
						</div>
						<div style="grid-column: 1 / -1;">
							<button type="submit" class="btn btn-primary btn-full">Рассчитать</button>
						</div>
					</div>
				</form>
			</div>

			<div id="calc-indicator" class="htmx-indicator loading-text">
				Ищем совпадения...
			</div>

			<div id="calculator-results">
				<div class="empty-state">
					<div class="empty-state__icon">🎓</div>
					<h3>Заполни форму выше</h3>
					<p>Укажи балл ЕНТ и два профильных предмета — покажем список вузов</p>
				</div>
			</div>
		</div>
	}
}

templ CalculatorResults(results []models.CalculatorResult) {
	if len(results) == 0 {
		<div class="empty-state">
			<div class="empty-state__icon">🔍</div>
			<h3>Ничего не найдено</h3>
			<p>Попробуй изменить параметры — другие предметы или снизить балл</p>
		</div>
	} else {
		<div class="results-count">
			Найдено программ: <strong>{ fmt.Sprintf("%d", len(results)) }</strong>
		</div>
		<div class="card-grid">
			for _, res := range results {
				<div class={ templ.KV("result-card", true), templ.KV("result-card--grant", res.Grant), templ.KV("result-card--paid", !res.Grant) }>
					<div class="result-card__header">
						<div>
							<div class="result-card__uni">{ res.University.Name.RU }</div>
							<div class="result-card__city">
								📍 { res.University.City }
								if res.University.Abbr != "" {
									&nbsp;· { res.University.Abbr }
								}
							</div>
						</div>
						if res.Grant {
							<span class="badge badge-grant">✓ Грант</span>
						} else {
							<span class="badge badge-muted">Платно</span>
						}
					</div>

					<div class="result-card__specialty">
						<div class="result-card__specialty-code">ГОП { res.Group.Code }</div>
						<div class="result-card__specialty-name">{ res.Group.Name.RU }</div>
					</div>

					<div class="result-card__stats">
						<div class="result-stat">
							<div class="result-stat__label">Мин. балл</div>
							<div class="result-stat__value">{ fmt.Sprintf("%d", res.EntReq.MinScore) }</div>
						</div>
						<div class="result-stat">
							<div class="result-stat__label">На грант</div>
							<div class="result-stat__value" style={ templ.KV("color: var(--color-success)", res.Grant) }>{ fmt.Sprintf("%d", res.EntReq.LastYearThreshold) }</div>
						</div>
					</div>
				</div>
			}
		</div>
	}
}
