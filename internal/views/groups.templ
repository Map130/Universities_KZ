package views

import (
	"fmt"
	"github.com/Map130/universities/internal/models"
)

templ GroupsPage(groups []models.SpecialtyGroup, page int) {
	@BaseLayout("Образовательные программы — UniSearch") {
		<div class="container">
			<div class="page-header">
				<h1>Образовательные программы</h1>
				<p>Группы ОП с кодами и необходимыми предметами ЕНТ</p>
			</div>

			if len(groups) == 0 {
				<div class="empty-state">
					<div class="empty-state__icon">📂</div>
					<h3>Группы не найдены</h3>
					if page > 1 {
						<p>Похоже, ты долистал до конца списка.</p>
					}
				</div>
				if page > 1 {
					<div style="display: flex; justify-content: center; margin-top: 1.5rem;">
						<a href={ templ.SafeURL(fmt.Sprintf("/groups?page=%d", page-1)) } class="btn btn-ghost btn-sm">
							← Назад
						</a>
					</div>
				}
			} else {
				<div class="card-grid">
					for _, group := range groups {
						<div class="group-card">
							<div class="group-card__code">{ group.Code }</div>
							<div class="group-card__name">{ group.Name.RU }</div>
						</div>
					}
				</div>

				<div class="pagination">
					if page > 1 {
						<a href={ templ.SafeURL(fmt.Sprintf("/groups?page=%d", page-1)) } class="btn btn-ghost btn-sm">
							← Назад
						</a>
					} else {
						<div></div>
					}

					<span class="pagination__page">Страница { fmt.Sprintf("%d", page) }</span>

					if len(groups) == 21 {
						<a href={ templ.SafeURL(fmt.Sprintf("/groups?page=%d", page+1)) } class="btn btn-ghost btn-sm">
							Вперёд →
						</a>
					} else {
						<div></div>
					}
				</div>
			}
		</div>
	}
}
