{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Specialty Schema",
  "description": "JSON Schema for a specialty (образовательная программа).",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The unique code of the specialty, e.g., '6B06101'"
    },
    "name": {
      "type": "object",
      "description": "Localized name of the specialty",
      "properties": {
        "ru": { "type": "string" },
        "kz": { "type": "string" },
        "en": { "type": "string" }
      },
      "required": ["ru", "kz"]
    },
    "group_code": {
      "type": "string",
      "description": "Code of the specialty group this specialty belongs to, e.g., 'B057'"
    },
    "metadata": {
      "type": "object",
      "description": "Information about data collection and source",
      "properties": {
        "source_system": { "type": "string" },
        "source_url": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" },
        "schema_version": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  },
  "required": ["code", "name", "group_code"]
}
